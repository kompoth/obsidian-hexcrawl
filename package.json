{
  "name": "obsidian-hexcrawl",
  "version": "0.1.0",
  "description": "A simplified hexcrawl map plugin for Obsidian.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "plugin"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "0.27.4",
    "obsidian": "latest",
    "tslib": "2.8.1",
    "typescript": "6.0.2",
    "vitest": "^5.0.0"
  }
}
